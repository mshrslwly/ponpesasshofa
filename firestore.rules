rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Akses baca & tulis untuk pengurus pesantren dan portal wali santri
    match /{document=**} {
      allow read, write: if true;
    }

    match /portalWali/{kodeAkses} {
      allow read, write: if true;
    }
  }
}
